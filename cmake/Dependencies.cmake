if(AERONET_ENABLE_BROTLI)
  # Brotli-specific configuration (applies only when fetched)
  set(BROTLI_DISABLE_TESTS ON CACHE BOOL "Disable brotli tests" FORCE)
  set(BROTLI_BUNDLED_MODE OFF CACHE BOOL "" FORCE)
  set(BROTLI_BUILD_TOOLS OFF CACHE BOOL "Disable brotli tools" FORCE)

  # Brotli does not reliably provide Debug libs on many systems,
  # so policy decides whether system packages are allowed.
  # The brotli build installs no CMake package. vcpkg adds one, unofficial-brotli, whose targets are aliased to the names
  # of the targets of the brotli build. AERONET_BROTLI_PACKAGE is the package that the consumers of aeronet look for.
  aeronet_system_packages_allowed(_brotli_allow_system)
  if(_brotli_allow_system)
    find_package(unofficial-brotli CONFIG QUIET)
  endif()
  if(unofficial-brotli_FOUND)
    set(AERONET_BROTLI_PACKAGE unofficial-brotli)
    foreach(_brotli_lib IN ITEMS brotlicommon brotlidec brotlienc)
      add_library(${_brotli_lib} ALIAS unofficial::brotli::${_brotli_lib})
    endforeach()
  else()
    aeronet_find_or_declare(
      NAME brotli
      CONFIG
      TARGETS
        brotlicommon
        brotlidec
        brotlienc
      DECLARE
        URL https://github.com/google/brotli/archive/refs/tags/v1.2.1.tar.gz
        URL_HASH SHA256=98d35d11a78dc453aebb7d10c3748f3f73ff78c8267c0dc697b8631f67bf7e8f
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    )
  endif()
endif()

if(AERONET_ENABLE_OPENTELEMETRY)

  aeronet_system_packages_allowed(_otel_allow_system)

  set(_USE_SYSTEM_OPENTELEMETRY FALSE)

  if(_otel_allow_system)
    find_package(opentelemetry-cpp CONFIG QUIET)
  endif()
  if(opentelemetry-cpp_FOUND)
    _aeronet_resolve_opentelemetry_targets(TRUE _otel_missing)
    if(NOT _otel_missing)
      message(STATUS "[aeronet] opentelemetry-cpp ${opentelemetry-cpp_VERSION} found")
      set(_USE_SYSTEM_OPENTELEMETRY TRUE)
    else()
      # Downloading opentelemetry-cpp would leave two of them in the programs linking the package of aeronet.
      aeronet_package_manager_used(_otel_package_manager)
      if(_otel_package_manager)
        message(FATAL_ERROR "[aeronet] the opentelemetry-cpp ${opentelemetry-cpp_VERSION} package has no ${_otel_missing} "
                            "target: build it with the OTLP HTTP exporter (vcpkg feature otlp-http, Conan option "
                            "with_otlp_http)")
      endif()
      message(STATUS "[aeronet] opentelemetry-cpp ${opentelemetry-cpp_VERSION} found without ${_otel_missing}: "
                     "downloading it")
    endif()
  endif()
  if(NOT _USE_SYSTEM_OPENTELEMETRY)

    # Hard requirements (never FetchContent these)
    find_package(CURL CONFIG QUIET)
    if(NOT CURL_FOUND)
      find_package(CURL QUIET)
    endif()

    if(NOT CURL_FOUND)
      message(FATAL_ERROR
        "AERONET_ENABLE_OPENTELEMETRY requires libcurl development files.")
    endif()

    _aeronet_find_protobuf(AERONET_ENABLE_OPENTELEMETRY)

    # ABI + feature configuration
    set(OTELCPP_WITH_STL OFF CACHE BOOL "Use nostd for ABI stability" FORCE)
    set(OTELCPP_WITH_HTTP_CLIENT_CURL ON CACHE BOOL "" FORCE)
    set(OTELCPP_WITH_OTLP_HTTP ON CACHE BOOL "" FORCE)
    set(OTELCPP_WITH_OTLP_GRPC OFF CACHE BOOL "" FORCE)

    # Optional: enable OTLP UTF-8 validation only when utf8_range is available.
    # Some protobuf packages do not ship utf8_range CMake targets, which causes
    # a warning in opentelemetry-cpp during configuration.
    find_package(utf8_range CONFIG QUIET)
    if(TARGET utf8_range::utf8_validity)
      set(OTELCPP_WITH_OTLP_UTF8_VALIDITY ON CACHE BOOL "" FORCE)
    elseif(TARGET utf8_validity AND NOT TARGET utf8_range::utf8_validity)
      add_library(utf8_range::utf8_validity ALIAS utf8_validity)
      set(OTELCPP_WITH_OTLP_UTF8_VALIDITY ON CACHE BOOL "" FORCE)
    else()
      set(OTELCPP_WITH_OTLP_UTF8_VALIDITY OFF CACHE BOOL "" FORCE)
      message(STATUS "utf8_range::utf8_validity not found; disabling OTLP UTF-8 validity checks")
    endif()

    set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
    set(OTELCPP_WITH_BENCHMARK OFF CACHE BOOL "" FORCE)
    set(OTELCPP_WITH_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(OTELCPP_WITH_FUNC_TESTS OFF CACHE BOOL "" FORCE)

    set(OTELCPP_WITH_ABI_VERSION_1 OFF CACHE BOOL "Use ABI v1" FORCE)
    set(OTELCPP_WITH_ABI_VERSION_2 ON CACHE BOOL "Use ABI v2" FORCE)

    # Not aeronet_find_or_declare: the package was looked for above.
    FetchContent_Declare(
      opentelemetry_cpp
      URL https://github.com/open-telemetry/opentelemetry-cpp/archive/refs/tags/v1.30.0.tar.gz
      URL_HASH SHA256=85aae7a42d7b71d17e510ddebc85db622d9078cc6d29cf9fb7373014b063859f
      DOWNLOAD_EXTRACT_TIMESTAMP TRUE
      EXCLUDE_FROM_ALL
    )
    list(APPEND AeronetFetchContentPackagesToMakeAvailable opentelemetry_cpp)

  endif()

endif()

if(AERONET_ENABLE_GLAZE)
  set(_aeronet_glaze_declare
    URL https://github.com/stephenberry/glaze/archive/refs/tags/v9.0.0.tar.gz
    URL_HASH SHA256=dd7b033c5bf6e4308615bb7834c541291d5b20f64121d9a68222a39414635517
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
  )
  # glaze is header-only, but its CMakeLists requires CMake 3.31 since glaze 8.1, and aeronet needs glaze >= 8.4.
