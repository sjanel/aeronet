@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Conditionally locate dependencies based on build-time options so that
# exported targets referencing their imported targets do not break consumer configure.
set(AERONET_WITH_OPENSSL "@AERONET_ENABLE_OPENSSL@")
set(AERONET_WITH_HTTP2 "@AERONET_ENABLE_HTTP2@")
set(AERONET_WITH_ZLIB "@AERONET_ENABLE_ZLIB@")
set(AERONET_WITH_ZSTD "@AERONET_ENABLE_ZSTD@")
set(AERONET_WITH_BROTLI "@AERONET_ENABLE_BROTLI@")
set(AERONET_BROTLI_PACKAGE "@AERONET_BROTLI_PACKAGE@")
set(AERONET_WITH_OPENTELEMETRY "@AERONET_ENABLE_OPENTELEMETRY@")
set(AERONET_WITH_WEBSOCKET "@AERONET_ENABLE_WEBSOCKET@")
set(AERONET_WITH_GLAZE "@AERONET_ENABLE_GLAZE@")
set(AERONET_WITH_PROTOBUF "@AERONET_ENABLE_PROTOBUF@")
set(AERONET_PROTOBUF_TARGET "@AERONET_PROTOBUF_TARGET@")

if(AERONET_WITH_OPENSSL)
	if(NOT TARGET OpenSSL::SSL)
		find_dependency(OpenSSL REQUIRED)
	endif()
endif()

if(AERONET_WITH_ZLIB)
	if(NOT TARGET ZLIBNG::ZLIBNG)
		find_dependency(zlib-ng CONFIG REQUIRED)
		# Same as the build of aeronet: zlib-ng::zlibstatic when zlib-ng installs both libraries, zlib-ng::zlib (static
		# or shared) when it installs only one, like vcpkg.
		add_library(ZLIBNG::ZLIBNG INTERFACE IMPORTED)
		if(TARGET zlib-ng::zlibstatic)
			target_link_libraries(ZLIBNG::ZLIBNG INTERFACE zlib-ng::zlibstatic)
		else()
			target_link_libraries(ZLIBNG::ZLIBNG INTERFACE zlib-ng::zlib)
		endif()
	endif()
endif()

if(AERONET_WITH_ZSTD)
	# Try to locate zstd only if none of the usual targets already exist.
	if(NOT (TARGET libzstd_static OR TARGET zstd::libzstd OR TARGET ZSTD::ZSTD))
		# Upstream (and vcpkg) typically installs a config named "zstd" that defines target zstd::libzstd.
		find_dependency(zstd CONFIG)
	endif()
	# Normalize: ensure libzstd_static alias exists so internally built code that referred to it stays valid.
	if(NOT TARGET libzstd_static)
		if(TARGET zstd::libzstd)
			add_library(libzstd_static INTERFACE IMPORTED)
			target_link_libraries(libzstd_static INTERFACE zstd::libzstd)
		elseif(TARGET ZSTD::ZSTD)
			add_library(libzstd_static INTERFACE IMPORTED)
			target_link_libraries(libzstd_static INTERFACE ZSTD::ZSTD)
		endif()
	endif()
endif()

# aeronet was built with a brotli package (vcpkg) rather than building brotli itself.
if(AERONET_WITH_BROTLI AND AERONET_BROTLI_PACKAGE)
	find_dependency(${AERONET_BROTLI_PACKAGE} CONFIG REQUIRED)
endif()

# An installed aeronet was built with an installed opentelemetry-cpp (with a downloaded one, aeronetTargets is not
# exported). Its targets are referenced by the exported ones: link-only dependencies of the static libraries, and the
# API headers that version.hpp includes.
if(AERONET_WITH_OPENTELEMETRY)
	if(NOT TARGET opentelemetry-cpp::api)
		find_dependency(opentelemetry-cpp CONFIG REQUIRED)
	endif()
endif()

if(AERONET_WITH_GLAZE)
	if(NOT TARGET glaze::glaze)
		find_dependency(glaze CONFIG REQUIRED)
	endif()
endif()

if(AERONET_WITH_PROTOBUF)
	if(NOT TARGET ${AERONET_PROTOBUF_TARGET})
		# The CMake package of protobuf (protobuf >= 22) first, then the FindProtobuf module of CMake.
		find_package(Protobuf CONFIG QUIET)
		if(NOT Protobuf_FOUND)
			find_dependency(Protobuf)
		endif()
	endif()
endif()

# If the vendored amc dependency was built internally (downloaded rather than found installed) it is linked
# privately, but the exported targets still reference amc::amc (as a link-only dependency of static libraries).
# Consumers do not need a separate amc package: create a lightweight interface target if it is absent.
# It must exist BEFORE aeronetTargets.cmake is loaded, which validates every target it references.
if(NOT TARGET amc::amc)
	add_library(amc::amc INTERFACE IMPORTED)
	# No include dirs needed: headers were installed alongside other public headers already.
endif()

include("${CMAKE_CURRENT_LIST_DIR}/aeronetTargets.cmake")

# Provide version variable
set(AERONET_VERSION_STR "@AERONET_PROJECT_VERSION@")
